# LedgerLens is intentionally demo-first. Never prefix these with NEXT_PUBLIC_;
# all values are read only by the server route.

# Preferred for Sites/Cloudflare: point this at a HTTPS service with fixed
# outbound IP that returns the public /api/portfolio contract. Its bearer token
# must be a dedicated read-only relay credential, not a Toss access token.
TOSS_RELAY_URL=
TOSS_RELAY_TOKEN=

# Stable server-only opaque identity for the relay account whose snapshots are
# stored in D1. It must exactly match LEDGERLENS_RELAY_ACCOUNT_REF on the fixed
# host. Do not use a raw account number and do not expose it to clients.
TOSS_RELAY_ACCOUNT_KEY=

# Direct mode is for a single-process local or self-hosted server whose fixed
# outbound IP is registered in Toss WTS. It is disabled unless the flag is true.
# As an alternative for personal localhost use, the Data screen can validate
# and encrypt these values into the Git-ignored private-data/ vault. Do not use
# that loopback-only vault as a public multi-user credential service.
TOSS_DIRECT_API_ENABLED=false
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# Optional when the credentials expose multiple accounts. When omitted, the
# first eligible BROKERAGE account returned by Toss is used.
TOSS_ACCOUNT_SEQ=

# Fixed-host relay ingress. Set these only on the single Direct-mode process
# with the WTS-registered egress IP. The shared token must be a high-entropy
# 32-512 character value without whitespace and must match TOSS_RELAY_TOKEN on
# Sites. The account ref is a stable opaque
# 8-128 character identifier and must match TOSS_RELAY_ACCOUNT_KEY on Sites.
# GET /api/relay/portfolio is the only relay operation; it is not a general
# proxy and it never exposes an order operation.
LEDGERLENS_RELAY_SHARED_TOKEN=
LEDGERLENS_RELAY_ACCOUNT_REF=

# Explicit loopback-only opt-in for local D1 history reads and manual captures.
# This is not an authentication bypass for deployed environments.
LEDGERLENS_ALLOW_LOCAL_HISTORY=false

# Non-loopback live data remains fail-closed unless a trusted hosting layer
# strips user-supplied identity headers and injects its authenticated user ID.
# Enable only on owner-only Sites or an equivalently trusted reverse proxy;
# never use this flag to "protect" an otherwise public host.
LEDGERLENS_TRUST_PLATFORM_AUTH=false

# Toss allows one active OAuth token per client. This app single-flights token
# refreshes inside one runtime. Multiple replicas must use a distributed token
# manager or, preferably, the single fixed-egress relay above.

# The Phase 4A schedule is fixed in code to weekdays at 07:10 Asia/Seoul
# (22:10 UTC on the prior day, `10 22 * * SUN-THU` in Cloudflare syntax).
# No environment value activates it: a real
# Cloudflare Cron trigger is a separate control-plane step and is not declared
# by .openai/hosting.json. Do not place cron or relay secrets in source control.

# Do not commit .env.local or Cloudflare .dev.vars files. Both are ignored by
# this repository.
